# TrustLink Web — Environment Variables
# Copy this file to .env and fill in your values.
# These are the SAME credentials as the mobile app's EXPO_PUBLIC_* vars.
# Only the anon key is used — never the service role key.

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
